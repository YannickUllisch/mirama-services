{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://*:8080"
      }
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "Authentication": {
    "Authority": "https://mirama.com",
    "Audience": "api://mirama.com"
  },
  "Outbox": {
    "PM": {
      "BatchSize": 50,
      "MaxRetries": 10,
      "MaxDegreeOfParallelism": 4,
      "LeaseDuration": "00:00:30",
      "BusyPollInterval": "00:00:00.200",
      "IdlePollInterval": "00:00:05"
    },
    "Clients": {
      "BatchSize": 50,
      "MaxRetries": 10,
      "MaxDegreeOfParallelism": 4,
      "LeaseDuration": "00:00:30",
      "BusyPollInterval": "00:00:00.200",
      "IdlePollInterval": "00:00:05"
    },
    "Identity": {
      "BatchSize": 50,
      "MaxRetries": 10,
      "MaxDegreeOfParallelism": 4,
      "LeaseDuration": "00:00:30",
      "BusyPollInterval": "00:00:00.200",
      "IdlePollInterval": "00:00:05"
    },
    "Workspace": {
      "BatchSize": 50,
      "MaxRetries": 10,
      "MaxDegreeOfParallelism": 4,
      "LeaseDuration": "00:00:30",
      "BusyPollInterval": "00:00:00.200",
      "IdlePollInterval": "00:00:05"
    }
  },
  "OutboxCleanup": {
    "PM": {
      "BatchSize": 500,
      "Interval": "00:15:00"
    },
    "Clients": {
      "BatchSize": 500,
      "Interval": "00:15:00"
    },
    "Identity": {
      "BatchSize": 500,
      "Interval": "00:15:00"
    },
    "Workspace": {
      "BatchSize": 500,
      "Interval": "00:15:00"
    }
  },
  "Inbox": {
    "PM": {
      "BatchSize": 200,
      "MaxRetries": 10,
      "MaxDegreeOfParallelism": 4,
      "LeaseDuration": "00:00:30",
      "BusyPollInterval": "00:00:00.200",
      "IdlePollInterval": "00:00:05"
    },
    "Clients": {
      "BatchSize": 200,
      "MaxRetries": 10,
      "MaxDegreeOfParallelism": 4,
      "LeaseDuration": "00:00:30",
      "BusyPollInterval": "00:00:00.200",
      "IdlePollInterval": "00:00:05"
    },
    "Identity": {
      "BatchSize": 200,
      "MaxRetries": 10,
      "MaxDegreeOfParallelism": 4,
      "LeaseDuration": "00:00:30",
      "BusyPollInterval": "00:00:00.200",
      "IdlePollInterval": "00:00:05"
    },
    "Workspace": {
      "BatchSize": 200,
      "MaxRetries": 10,
      "MaxDegreeOfParallelism": 4,
      "LeaseDuration": "00:00:30",
      "BusyPollInterval": "00:00:00.200",
      "IdlePollInterval": "00:00:05"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Async",
      "Serilog.Sinks.File",
      "Serilog.Exceptions"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console",
              "Args": {
                "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
              }
            },
            {
              "Name": "File",
              "Args": {
                "path": "logs/log-.txt",
                "rollingInterval": "Day",
                "retainedFileCountLimit": 7,
                "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
              }
            }
          ]
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithExceptionDetails"
    ],
    "Properties": {
      "Application": "Mirama-API"
    }
  }
}
